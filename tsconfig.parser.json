{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/cli.ts", "src/cli-youth.ts", "src/extract.ts", "src/run.ts", "src/schema.ts", "src/source.ts", "src/youth-source.ts", "test/**/*.ts"]
}
